# =====================================================
# SLAM型配送：stepループ + 可視化（完全検証用）
# =====================================================

import heapq
import random
import time
from copy import deepcopy

# =====================
# マップ（仕様準拠）
# =====================
RAW_MAP = [
"■■■Ｂ・・◆◆◆◆・・Ａ■■■",
"■■■■・・◆◆◆◆・・■■■■",
"■■■■・・◆◆◆◆・・■■■■",
"■■■■・・②＃＃＃・・■■■■",
"■■■■・・＃＃＃②・・■■■■",
"■■■■・・◆◆◆◆・・■■■■",
"・・・・・・◆◆◆◆・・・・・・",
"・・・・・・◆◆◆◆・・・・・・",
"◆＃①◆◆◆◆◆◆◆◆◆◆＃①◆",
"◆＃＃◆◆◆◆◆◆◆◆◆◆＃＃◆",
"◆＃＃◆◆◆◆◆◆◆◆◆◆＃＃◆",
"◆①＃◆◆◆◆◆◆◆◆◆◆①＃◆",
"・・・・・・◆◆◆◆・・・・・・",
"・・・・・・◆◆◆◆・・・・・・",
"■Ｃ■■・・②＃＃＃・・受■■■",
"■■■■・・＃＃＃②・・■■■■",
]

H, W = 16, 16

# =====================
# 定数
# =====================
ASTAR_BLOCK = {'■', '◆', '◎'}
WALKABLE = {'・', '＃'}
DIRS = [(-1,0),(0,-1),(1,0),(0,1)]  # 北西南東
ARROWS = {0:'▲',1:'◀',2:'▼',3:'▶'}

CNN_SIZE = 5
CENTER = 2
MAX_STEPS = 50

# =====================
# A*
# =====================
def heuristic(a,b):
    return abs(a[0]-b[0])+abs(a[1]-b[1])

def astar(grid,start,goal):
    pq=[(0,start)]
    came={}
    cost={start:0}

    while pq:
        _,cur=heapq.heappop(pq)
        if cur==goal: break
        for d in DIRS:
            nr,nc=cur[0]+d[0],cur[1]+d[1]
            if not(0<=nr<H and 0<=nc<W): continue
            if grid[nr][nc] in ASTAR_BLOCK: continue
            ncost=cost[cur]+1
            if (nr,nc) not in cost or ncost<cost[(nr,nc)]:
                cost[(nr,nc)]=ncost
                pr=ncost+heuristic((nr,nc),goal)
                heapq.heappush(pq,(pr,(nr,nc)))
                came[(nr,nc)]=cur
    if goal not in came: return None
    path=[goal]
    while path[-1]!=start:
        path.append(came[path[-1]])
    return path[::-1]

# =====================
# 人配置
# =====================
def place_people(grid,max_people=8):
    cells=[(r,c) for r in range(H) for c in range(W) if grid[r][c] in WALKABLE]
    random.shuffle(cells)
    people=[]
    for r,c in cells:
        if len(people)>=max_people: break
        ok=True
        for dr in range(-2,3):
            for dc in range(-2,3):
                nr,nc=r+dr,c+dc
                if 0<=nr<H and 0<=nc<W:
                    if grid[nr][nc] in {'Ａ','Ｂ','Ｃ','受','◯','◎'}:
                        ok=False
        if ok:
            grid[r][c]='◯'
            people.append((r,c))
    return people

# =====================
# CNN
# =====================
def get_cnn(grid,pos,dir):
    cnn=[['■']*CNN_SIZE for _ in range(CNN_SIZE)]
    for y in range(CNN_SIZE):
        for x in range(CNN_SIZE):
            dy,dx=y-CENTER,x-CENTER
            if dir==0: ry,rx=dy,dx
            elif dir==1: ry,rx=dx,-dy
            elif dir==2: ry,rx=-dy,-dx
            else: ry,rx=-dx,dy
            r,c=pos[0]+ry,pos[1]+rx
            if 0<=r<H and 0<=c<W:
                cnn[y][x]=grid[r][c]
    return cnn

# =====================
# 表示
# =====================
def draw(grid,agent):
    disp=deepcopy(grid)
    r,c,d=agent
    disp[r][c]=ARROWS[d]
    print("\n".join("".join(r) for r in disp))
    print("-"*30)

# =====================
# メイン
# =====================
if __name__=="__main__":
    base=[list(r) for r in RAW_MAP]

    for r in range(H):
        for c in range(W):
            if base[r][c]=='受': start=(r,c)
            if base[r][c]=='Ａ': goal=(r,c)

    route_map=deepcopy(base)
    path=astar(route_map,start,goal)

    congestion=deepcopy(base)
    place_people(congestion)

    agent_pos=start
    agent_dir=0
    step_idx=0

    while step_idx<MAX_STEPS and path:
        draw(congestion,(agent_pos[0],agent_pos[1],agent_dir))

        cnn=get_cnn(congestion,agent_pos,agent_dir)

        # 人回避
        if cnn[1][2]=='◯':
            for y in range(CNN_SIZE):
                for x in range(CNN_SIZE):
                    if cnn[y][x]=='◯':
                        rr=agent_pos[0]+(y-CENTER)
                        cc=agent_pos[1]+(x-CENTER)
                        congestion[rr][cc]='◎'
            path=astar(congestion,agent_pos,goal)
            print("👀 人検知 → 停止 & 再A*")
            time.sleep(0.3)
            step_idx+=1
            continue

        # 次ノードへ
        if len(path)>1:
            nr,nc=path[1]
            dr,dc=nr-agent_pos[0],nc-agent_pos[1]
            agent_dir=DIRS.index((dr,dc))
            agent_pos=(nr,nc)
            path=path[1:]
        else:
            break

        step_idx+=1
        time.sleep(0.3)

    print("終了")